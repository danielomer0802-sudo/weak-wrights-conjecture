  · rw [if_neg hz, sub_zero]
    have hb : ‖(Complex.exp ((N:ℂ) * f z))⁻¹‖ ≤ Real.exp (-N*d) := by
      rw [← Complex.exp_neg, Complex.norm_exp, Complex.neg_re, Complex.mul_re]
