    · exact Subsingleton.elim _ _
  · let := htr
    let f : ℝ → ℝ := fun t => Real.sqrt (1-t^2)
    have hf : Continuous f := (continuous_const.sub (continuous_id.pow 2)).sqrt
    let D : H →L[ℂ] H := cfc f C
