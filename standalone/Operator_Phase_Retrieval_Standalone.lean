section Complement
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem complement_norm_identity (C D : H →L[ℂ] H)
    (hC : IsSelfAdjoint C) (hD : IsSelfAdjoint D) (hsq : C*C+D*D=1) (f : H) :
    ‖C f‖^2 + ‖D f‖^2 = ‖f‖^2 := by
