      by simpa using (uniformPolynomialClosure K).add_mem hf.2 hg.2⟩
  mul_mem' := by
    intro f g hf hg
    exact ⟨(uniformPolynomialClosure K).mul_mem hf.1 hg.1,
      by simpa using (uniformPolynomialClosure K).mul_mem hf.2 hg.2⟩
