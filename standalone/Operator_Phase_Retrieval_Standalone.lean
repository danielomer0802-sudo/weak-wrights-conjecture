  · rw [phaseFamily_star P hP.2, phaseFamily_mul P hP.1, mul_comm, hu]
    exact phaseFamily_one P
  · rw [phaseFamily_star P hP.2, phaseFamily_mul P hP.1, hu]
    exact phaseFamily_one P

