      WithLp.add_fst, WithLp.smul_fst, map_add, map_smul]
    module
  · simp [phaseFamily, add_apply, smul_apply,
      WithLp.add_snd, WithLp.smul_snd,
      map_add, map_smul]
    module

end OperatorPhaseRetrieval

end


