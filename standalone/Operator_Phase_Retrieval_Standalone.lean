    apply Lp.ext
    filter_upwards [(memLp_densityRoot hf hpos (c • u)).coeFn_toLp,
      (memLp_densityRoot hf hpos u).coeFn_toLp,
      Lp.coeFn_smul c ((memLp_densityRoot hf hpos u).toLp _),
