theorem exists_polynomial_dense_measure :
    ∃ μ : Measure ℂ, IsFiniteMeasure μ ∧ μ ≠ 0 ∧ μ ≪ volume ∧
      ∃ hm : ∀ p : Polynomial ℂ, MemLp (fun z => p.eval z) 2 μ,
