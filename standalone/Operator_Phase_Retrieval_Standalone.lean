  toFun u := (memLp_densityRoot hf hpos u).toLp _
  map_add' u v := by
    apply Lp.ext
    filter_upwards [(memLp_densityRoot hf hpos (u+v)).coeFn_toLp,
      (memLp_densityRoot hf hpos u).coeFn_toLp, (memLp_densityRoot hf hpos v).coeFn_toLp,
